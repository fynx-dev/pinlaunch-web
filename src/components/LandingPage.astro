---
import { hrefForLocale, localeList, privacyHrefForLocale, type LocaleContent } from "../content";

interface Props { content: LocaleContent; }
const { content } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
const asset = (name: string) => `${base}assets/${name}`;
const headingLines = (value: string) => value.split("\n");
const demoApps = [
  ["Google Chrome", "apps/googlechrome.svg"],
  ["Visual Studio Code", "apps/visualstudiocode.svg"],
  ["Firefox", "apps/firefox.svg"],
  ["Obsidian", "apps/obsidian.svg"],
  ["Notion", "apps/notion.svg"],
  ["Slack", "apps/slack.svg"]
];
---
<a class="skip-link" href="#main-content">{content.nav.skip}</a>
<header class="site-header wrap">
  <a class="logo" href={hrefForLocale(content, base)} aria-label="PinLaunch">
    <img src={asset("pinlaunch-icon.svg")} width="32" height="32" alt="" />
    <span>PinLaunch</span>
  </a>
  <nav class="nav-links" aria-label="Primary navigation">
    <a href="#how">{content.nav.how}</a>
    <a href={privacyHrefForLocale(content, base)}>{content.nav.privacy}</a>
  </nav>
  <label class="language-menu">
    <span class="language-label">{content.nav.language}</span>
    <select class="language-select" data-language-select aria-label={content.nav.language}>
      {localeList.map((locale) => <option value={hrefForLocale(locale, base)} lang={locale.code} selected={locale.code === content.code}>{locale.nativeName}</option>)}
    </select>
  </label>
</header>
<main id="main-content">
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div class="hero-content">
        <p class="eyebrow reveal">{content.hero.eyebrow}</p>
        <h1 class="reveal" id="hero-title">{content.hero.title}<br /><em>{content.hero.emphasis}</em></h1>
        <p class="hero-copy reveal">{content.hero.lead}</p>
        <div class="hero-actions reveal">
          <p class="availability">{content.hero.availability}</p>
          <small>{content.hero.platform}</small>
        </div>
        <ul class="hero-points reveal">
          {content.hero.points.map((point) => <li>{point}</li>)}
        </ul>
      </div>
      <div class="stage reveal" data-demo aria-label={content.hero.demoLabel}>
        <div class="launcher" id="pinlaunch-demo-menu" role="menu" aria-label={content.hero.menuTitle}>
          <div class="launcher-top"><span>PinLaunch</span><button class="mini-action" type="button" data-demo-close aria-label={content.hero.closeMenu}>×</button></div>
          <div class="menu-list">
            {demoApps.map(([name, icon]) => <button class="menu-app" type="button" role="menuitem" data-demo-item><img src={asset(icon)} width="19" height="19" alt="" /><span>{name}</span></button>)}
          </div>
        </div>
        <p class="demo-toast" role="status" aria-live="polite"></p>
        <div class="demo-taskbar"><button class="taskbar-launch is-active" type="button" data-demo-toggle aria-expanded="true" aria-controls="pinlaunch-demo-menu" aria-label={content.hero.openMenu}><img src={asset("pinlaunch-icon.svg")} width="32" height="32" alt="" /></button></div>
      </div>
    </div>
  </section>

  <div class="strip"><div class="wrap strip-items">{content.strip.map((item) => <span>{item}</span>)}</div></div>

  <section id="how" aria-labelledby="how-title"><div class="wrap">
    <div class="intro"><p class="eyebrow">{content.problem.eyebrow}</p><div><h2 id="how-title">{headingLines(content.problem.title).map((line) => <><span>{line}</span><br /></>)}</h2><p>{content.problem.lead}</p></div></div>
    <div class="flow">{content.problem.steps.map((step) => <article class="flow-row"><div class="flow-heading"><span class="flow-num">{step.number}</span><h3>{step.title}</h3></div><p>{step.text}</p></article>)}</div>
  </div></section>

  <section class="privacy" id="privacy" aria-labelledby="privacy-title"><div class="wrap privacy-box">
    <div class="privacy-copy"><p class="eyebrow">{content.privacy.eyebrow}</p><h2 id="privacy-title">{headingLines(content.privacy.title).map((line) => <><span>{line}</span><br /></>)}</h2><p>{content.privacy.lead}</p><ul class="privacy-list">{content.privacy.items.map((item) => <li>{item}</li>)}</ul></div>
    <div class="privacy-art" role="img" aria-label={content.privacy.artLabel}><div class="privacy-device" aria-hidden="true"><span class="privacy-device-bar"></span><div class="privacy-device-lock"><span></span></div></div></div>
  </div></section>

  <section class="closing" aria-labelledby="closing-title"><div class="wrap">
    <div class="closing-inner"><div><p class="eyebrow">{content.closing.eyebrow}</p><h2 id="closing-title">{headingLines(content.closing.title).map((line) => <><span>{line}</span><br /></>)}</h2></div><div><p>{content.closing.lead}</p><p class="closing-availability">{content.closing.availability}</p></div></div>
    <footer><p>{content.footer.copyright}</p><p><a href={privacyHrefForLocale(content, base)}>{content.footer.privacy}</a></p></footer>
  </div></section>
</main>
<script>
  import "../scripts/demo.ts";
</script>
