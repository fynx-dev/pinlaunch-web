---
import LandingPage from "../components/LandingPage.astro";
import PrivacyPage from "../components/PrivacyPage.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { localeList, locales, type LocaleCode } from "../content";

export function getStaticPaths() {
  return localeList.flatMap((locale) => [
    {
      params: { slug: locale.path || undefined },
      props: { locale: locale.code, page: "landing" }
    },
    {
      params: { slug: locale.path ? `${locale.path}/privacy` : "privacy" },
      props: { locale: locale.code, page: "privacy" }
    }
  ]);
}

const { locale, page } = Astro.props as { locale: LocaleCode; page: "landing" | "privacy" };
const content = locales[locale];
---
<BaseLayout {content} {page}>
  {page === "privacy" ? <PrivacyPage {content} /> : <LandingPage {content} />}
</BaseLayout>
